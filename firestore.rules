rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Produits : visibles par tout le monde, modifiables uniquement par l'admin
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Commandes : un client peut créer/lire les siennes, l'admin voit et gère tout
    match /orders/{orderId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Comptes utilisateurs : chacun gère son propre profil, ne peut pas s'auto-promouvoir admin
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.role == 'client';
      allow update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }

    // Paramètres de la boutique : lecture publique, écriture admin uniquement
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
